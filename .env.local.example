NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Used for auth email redirect links (signup confirmation, password reset)
# when a request has no Origin header. Falls back to http://localhost:3000
# if unset. Set this to your deployed URL in production.
NEXT_PUBLIC_SITE_URL=

# Optional: Cloudflare Turnstile (https://dash.cloudflare.com/?to=/:account/turnstile)
# free CAPTCHA for the public inquiry/sell-property/signup forms. Leave both
# unset to leave Turnstile disabled (forms still work, just unprotected).
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# Optional: Sentry (https://sentry.io) error monitoring, free tier covers
# 5k errors/month. Sentry DSNs are meant to be public. Leave unset to leave
# error reporting disabled (errors still log to the server console).
NEXT_PUBLIC_SENTRY_DSN=

# Optional: Resend (https://resend.com) transactional email, free tier
# covers 3k emails/month. Leave unset to leave email notifications disabled
# (new inquiries/submissions/status changes just won't send email — nothing
# else breaks). RESEND_FROM_EMAIL must be a verified sender/domain in your
# Resend account; defaults to Resend's shared onboarding@resend.dev sender
# (fine for testing, not for real deliverability) if unset.
RESEND_API_KEY=
RESEND_FROM_EMAIL=
